{
  "name": "@albinn/pgp",
  "version": "0.1.1",
  "description": "Pi extension: review GitHub PR feedback and address it (read-only)",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "github",
    "pull-request",
    "code-review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbinLind/pgp.git"
  },
  "homepage": "https://github.com/AlbinLind/pgp#readme",
  "bugs": {
    "url": "https://github.com/AlbinLind/pgp/issues"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/AlbinLind/pgp/main/media/quick-demo.gif"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "dev:fetch": "node scripts/dev-fetch.ts",
    "dev:diff": "node scripts/dev-diff.ts",
    "dev:patch": "node scripts/dev-patch.ts",
    "dev:config": "node scripts/dev-config.ts",
    "dev:triage": "node scripts/dev-triage.ts",
    "dev:command": "node scripts/dev-command.ts",
    "dev:tui": "node scripts/dev-tui-command.ts",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
